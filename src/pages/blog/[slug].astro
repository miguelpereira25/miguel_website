---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.filter((p) => !p.data.draft && !p.data.externalUrl).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout title={`${post.data.title} — Miguel Pereira`} description={post.data.description}>
  <div class="read-progress" aria-hidden="true"><span id="read-progress-bar"></span></div>

  <Nav active="writing" />

  <main class="post-page">
    <a href="/#writing" class="post-back">&larr; Back</a>

    <header class="post-header">
      <div class="post-tags">
        {post.data.tags.map((tag) => (
          <span class="post-tag">{tag}</span>
        ))}
      </div>
      <h1 class="post-title">{post.data.title}</h1>
      <time class="post-date" datetime={post.data.date.toISOString()}>
        {formatDate(post.data.date)}
      </time>
    </header>

    <div class="post-body">
      <Content />
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const bar = document.getElementById('read-progress-bar');
  function updateProgress() {
    if (!bar) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(1, window.scrollY / max) : 0;
    bar.style.width = `${p * 100}%`;
  }
  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress, { passive: true });
</script>
