<style>
  /* ── Page layout ── */
  .cv-page {
    padding: var(--section-pad);
    padding-top: 64px;
  }

  .cv-inner {
    max-width: var(--max-w);
    margin: 0 auto;
  }

  /* ── Header ── */
  .cv-header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: end;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0;
  }

  .cv-name {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 8px;
  }

  .cv-role {
    font-size: 0.82rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cv-contact {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: right;
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .cv-contact a {
    color: var(--muted);
    transition: color 0.2s;
  }

  .cv-contact a:hover {
    color: var(--accent);
  }

  .cv-download {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  /* ── Section ── */
  .cv-section {
    padding: 36px 0;
    border-bottom: 1px solid var(--border);
  }

  .cv-section:last-child {
    border-bottom: none;
  }

  .cv-section-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cv-section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  /* ── Entries ── */
  .cv-entries {
    display: flex;
    flex-direction: column;
  }

  .cv-entry {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }

  .cv-entry:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .cv-entry:first-child {
    padding-top: 0;
  }

  .cv-entry-date {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 2px;
  }

  .cv-date {
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .cv-part-time {
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid rgba(57, 255, 142, 0.25);
    padding: 1px 5px;
    border-radius: 2px;
    width: fit-content;
  }

  .cv-entry-header {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-bottom: 8px;
  }

  .cv-entry-title {
    font-family: var(--font-heading);
    font-size: 0.97rem;
    font-weight: 600;
    color: var(--text);
  }

  .cv-entry-company {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .cv-entry-desc {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 10px;
  }

  .cv-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .cv-tag {
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--border);
    padding: 2px 7px;
    border-radius: var(--radius);
  }

  /* ── Skills grid ── */
  .cv-skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 48px;
  }

  /* ── Two-col sections ── */
  .cv-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 48px;
  }

  .cv-two-col .cv-section {
    border-bottom: 1px solid var(--border);
  }

  /* ── Languages ── */
  .cv-langs {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }

  .cv-lang {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .cv-lang-name {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
  }

  .cv-lang-level {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* ── Responsive ── */
  @media (max-width: 720px) {
    .cv-header {
      grid-template-columns: 1fr;
      gap: 24px;
      align-items: start;
    }

    .cv-contact {
      text-align: left;
    }

    .cv-entry {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .cv-skills-grid {
      grid-template-columns: 1fr;
    }

    .cv-two-col {
      grid-template-columns: 1fr;
    }

    .cv-langs {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.querySelectorAll<HTMLElement>('.skill-bar').forEach((bar) => {
            bar.classList.add('animate');
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.2 }
  );

  document.querySelectorAll<HTMLElement>('.cv-skills-grid .skill-list').forEach((el) => {
    observer.observe(el);
  });
</script>
