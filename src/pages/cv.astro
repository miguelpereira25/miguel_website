---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="CV — Miguel Pereira" description="Curriculum vitae of Miguel Pereira — Security Engineer, PSIRT, CNA, OWASP Leiria co-lead.">
  <Nav active="cv" />

  <main class="cv-page">
    <div class="cv-inner">

      <!-- Header -->
      <header class="cv-header reveal">
        <div class="cv-header-left">
          <p class="section-label">// Curriculum Vitae</p>
          <h1 class="cv-name">Miguel Pereira</h1>
          <p class="cv-role">Security Engineer · PSIRT · CNA</p>
        </div>
        <div class="cv-header-right">
          <div class="cv-contact">
            <a href="https://github.com/miguelpereira25" target="_blank" rel="noopener">github.com/miguelpereira25</a>
            <a href="https://www.linkedin.com/in/miguelpereira25/" target="_blank" rel="noopener">linkedin.com/in/miguelpereira25</a>
            <span>Portugal · Category B licence</span>
          </div>
          <button type="button" id="cv-print" class="btn btn-primary cv-download">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Save as PDF
          </button>
        </div>
      </header>

      <!-- Experience -->
      <section class="cv-section reveal">
        <h2 class="cv-section-title">
          <span>Experience</span>
        </h2>

        <div class="cv-entries">

          <div class="cv-entry">
            <div class="cv-entry-date">
              <span class="cv-date">2022 — present</span>
            </div>
            <div class="cv-entry-body">
              <div class="cv-entry-header">
                <span class="cv-entry-title">Security Engineer</span>
                <span class="cv-entry-company">Siemens ProductCERT / PSIRT</span>
              </div>
              <p class="cv-entry-desc">
                Started as a developer building and maintaining the team's internal vulnerability handling tools, then shifted into a security analyst role: CNA (CVE Numbering Authority) operations, vulnerability monitoring, and coordinated disclosure for industrial and enterprise products. Responsible for the conference monitoring service — attending key security conferences, building relationships with leaders, researchers, and strategic partners while tracking research and trends that may impact Siemens products. MSc research thread on decentralised vulnerability databases running in parallel.
              </p>
              <div class="cv-tags">
                <span class="cv-tag">CVD</span>
                <span class="cv-tag">CNA</span>
                <span class="cv-tag">OT/ICS</span>
                <span class="cv-tag">PSIRT</span>
                <span class="cv-tag">Tooling</span>
                <span class="cv-tag">Conference Monitoring</span>
              </div>
            </div>
          </div>

          <div class="cv-entry">
            <div class="cv-entry-date">
              <span class="cv-date">08/2021 — 12/2021</span>
              <span class="cv-part-time">internship</span>
            </div>
            <div class="cv-entry-body">
              <div class="cv-entry-header">
                <span class="cv-entry-title">Cyber Security R&D Intern</span>
                <span class="cv-entry-company">Dognaedis (Cipher) · Coimbra</span>
              </div>
              <p class="cv-entry-desc">
                Built a Django web platform with user authentication, Celery async task processing, AI image analysis for phishing detection, and a DNS lookup pipeline.
              </p>
              <div class="cv-tags">
                <span class="cv-tag">Django</span>
                <span class="cv-tag">Celery</span>
                <span class="cv-tag">Python</span>
                <span class="cv-tag">AI/ML</span>
              </div>
            </div>
          </div>

          <div class="cv-entry">
            <div class="cv-entry-date">
              <span class="cv-date">12/2019 — present</span>
              <span class="cv-part-time">part-time</span>
            </div>
            <div class="cv-entry-body">
              <div class="cv-entry-header">
                <span class="cv-entry-title">Bartender & Waiter</span>
                <span class="cv-entry-company">Grande Hotel de Luso</span>
              </div>
            </div>
          </div>

          <div class="cv-entry">
            <div class="cv-entry-date">
              <span class="cv-date">04/2017 — 03/2020</span>
              <span class="cv-part-time">part-time</span>
            </div>
            <div class="cv-entry-body">
              <div class="cv-entry-header">
                <span class="cv-entry-title">Bartender & Waiter</span>
                <span class="cv-entry-company">Curia Palace Hotel Golf & Spa · Anadia</span>
              </div>
            </div>
          </div>

          <div class="cv-entry">
            <div class="cv-entry-date">
              <span class="cv-date">04/2016 — 08/2019</span>
              <span class="cv-part-time">part-time</span>
            </div>
            <div class="cv-entry-body">
              <div class="cv-entry-header">
                <span class="cv-entry-title">Bartender & Waiter</span>
                <span class="cv-entry-company">Caterfesta · Anadia</span>
              </div>
            </div>
          </div>

          <div class="cv-entry">
            <div class="cv-entry-date">
              <span class="cv-date">07/2016 — 12/2017</span>
            </div>
            <div class="cv-entry-body">
              <div class="cv-entry-header">
                <span class="cv-entry-title">Warehouse & Expedition</span>
                <span class="cv-entry-company">Caves da Montanha · Anadia</span>
              </div>
            </div>
          </div>

          <div class="cv-entry">
            <div class="cv-entry-date">
              <span class="cv-date">01/2015 — 09/2016</span>
              <span class="cv-part-time">part-time</span>
            </div>
            <div class="cv-entry-body">
              <div class="cv-entry-header">
                <span class="cv-entry-title">Bartender</span>
                <span class="cv-entry-company">Rodoviária pub & bar · Anadia</span>
              </div>
            </div>
          </div>

          <div class="cv-entry">
            <div class="cv-entry-date">
              <span class="cv-date">07/2013 — 12/2015</span>
            </div>
            <div class="cv-entry-body">
              <div class="cv-entry-header">
                <span class="cv-entry-title">Production Worker</span>
                <span class="cv-entry-company">Caves da Montanha · Anadia</span>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- Education -->
      <section class="cv-section reveal">
        <h2 class="cv-section-title"><span>Education</span></h2>
        <div class="cv-entries">
          <div class="cv-entry">
            <div class="cv-entry-date">
              <span class="cv-date">2025 — present</span>
            </div>
            <div class="cv-entry-body">
              <div class="cv-entry-header">
                <span class="cv-entry-title">MSc in Cybersecurity and Forensics</span>
                <span class="cv-entry-company">Polytechnic of Leiria</span>
              </div>
            </div>
          </div>
          <div class="cv-entry">
            <div class="cv-entry-date">
              <span class="cv-date">2016 — 2022</span>
            </div>
            <div class="cv-entry-body">
              <div class="cv-entry-header">
                <span class="cv-entry-title">BSc in Computer Science and Engineering</span>
                <span class="cv-entry-company">Polytechnic of Guarda</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Skills -->
      <section class="cv-section reveal">
        <h2 class="cv-section-title"><span>Skills</span></h2>
        <div class="cv-skills-grid">
          <div class="skill-list" id="cv-skills-left">
            <div class="skill-item">
              <div class="skill-header">
                <span class="skill-name">CVD / CNA Operations</span>
                <span class="skill-pct">95%</span>
              </div>
              <div class="skill-track"><div class="skill-bar" style="--target-width: 95%"></div></div>
            </div>
            <div class="skill-item">
              <div class="skill-header">
                <span class="skill-name">OT / ICS Security</span>
                <span class="skill-pct">85%</span>
              </div>
              <div class="skill-track"><div class="skill-bar" style="--target-width: 85%"></div></div>
            </div>
            <div class="skill-item">
              <div class="skill-header">
                <span class="skill-name">GitHub / Version Control</span>
                <span class="skill-pct">80%</span>
              </div>
              <div class="skill-track"><div class="skill-bar" style="--target-width: 80%"></div></div>
            </div>
            <div class="skill-item">
              <div class="skill-header">
                <span class="skill-name">Python & Automation</span>
                <span class="skill-pct">75%</span>
              </div>
              <div class="skill-track"><div class="skill-bar" style="--target-width: 75%"></div></div>
            </div>
          </div>
          <div class="skill-list">
            <div class="skill-item">
              <div class="skill-header">
                <span class="skill-name">Django + PostgreSQL</span>
                <span class="skill-pct">70%</span>
              </div>
              <div class="skill-track"><div class="skill-bar" style="--target-width: 70%"></div></div>
            </div>
            <div class="skill-item">
              <div class="skill-header">
                <span class="skill-name">Docker</span>
                <span class="skill-pct">65%</span>
              </div>
              <div class="skill-track"><div class="skill-bar" style="--target-width: 65%"></div></div>
            </div>
            <div class="skill-item">
              <div class="skill-header">
                <span class="skill-name">AI / ML (Keras, Colab)</span>
                <span class="skill-pct">60%</span>
              </div>
              <div class="skill-track"><div class="skill-bar" style="--target-width: 60%"></div></div>
            </div>
            <div class="skill-item">
              <div class="skill-header">
                <span class="skill-name">ASP.NET · SQL · Java</span>
                <span class="skill-pct">30%</span>
              </div>
              <div class="skill-track"><div class="skill-bar" style="--target-width: 30%"></div></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Network & Associations -->
      <section class="cv-section reveal">
        <h2 class="cv-section-title"><span>Network & Associations</span></h2>
        <div class="cv-entries">

          <div class="cv-entry">
            <div class="cv-entry-date"><span class="cv-date">2022 — present</span></div>
            <div class="cv-entry-body">
              <div class="cv-entry-header">
                <span class="cv-entry-title">Co-Lead</span>
                <span class="cv-entry-company">OWASP Leiria</span>
              </div>
            </div>
          </div>

          <div class="cv-entry">
            <div class="cv-entry-date"><span class="cv-date">09/2018 — 09/2019</span></div>
            <div class="cv-entry-body">
              <div class="cv-entry-header">
                <span class="cv-entry-title">Member, CS & Engineering dept</span>
                <span class="cv-entry-company">Academic Association of Guarda</span>
              </div>
            </div>
          </div>

          <div class="cv-entry">
            <div class="cv-entry-date"><span class="cv-date">12/2020 — 10/2021</span></div>
            <div class="cv-entry-body">
              <div class="cv-entry-header">
                <span class="cv-entry-title">President of Fiscal Council</span>
                <span class="cv-entry-company">Degree Student Nucleus · Polytechnic of Guarda</span>
              </div>
            </div>
          </div>

          <div class="cv-entry">
            <div class="cv-entry-date"><span class="cv-date">07/2019 — 12/2020</span></div>
            <div class="cv-entry-body">
              <div class="cv-entry-header">
                <span class="cv-entry-title">Vice-President</span>
                <span class="cv-entry-company">Degree Student Nucleus · Polytechnic of Guarda</span>
              </div>
            </div>
          </div>

          <div class="cv-entry">
            <div class="cv-entry-date"><span class="cv-date">07/2018 — 07/2019</span></div>
            <div class="cv-entry-body">
              <div class="cv-entry-header">
                <span class="cv-entry-title">Director of Events</span>
                <span class="cv-entry-company">Degree Student Nucleus · Polytechnic of Guarda</span>
              </div>
            </div>
          </div>

          <div class="cv-entry">
            <div class="cv-entry-date"><span class="cv-date">07/2017 — 07/2018</span></div>
            <div class="cv-entry-body">
              <div class="cv-entry-header">
                <span class="cv-entry-title">Vogal</span>
                <span class="cv-entry-company">Computer Science Students Nucleus</span>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- Projects & Volunteer -->
      <div class="cv-two-col">

        <section class="cv-section reveal">
          <h2 class="cv-section-title"><span>Projects</span></h2>
          <div class="cv-entries">
            <div class="cv-entry">
              <div class="cv-entry-date"><span class="cv-date">03/2019 — 06/2019</span></div>
              <div class="cv-entry-body">
                <div class="cv-entry-header">
                  <span class="cv-entry-title">Firefighter Robot Contest 2019</span>
                  <span class="cv-entry-company">Polytechnic Institute of Guarda</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="cv-section reveal">
          <h2 class="cv-section-title"><span>Volunteer</span></h2>
          <div class="cv-entries">
            <div class="cv-entry">
              <div class="cv-entry-date"><span class="cv-date">2021 - present</span></div>
              <div class="cv-entry-body">
                <div class="cv-entry-header">
                  <span class="cv-entry-title">Wildfire Watch</span>
                  <span class="cv-entry-company">Associação de Voluntários de Ferreiros</span>
                </div>
              </div>
            </div>
          </div>
        </section>

      </div>

      <!-- Languages -->
      <section class="cv-section reveal">
        <h2 class="cv-section-title"><span>Languages</span></h2>
        <div class="cv-langs">
          <div class="cv-lang">
            <span class="cv-lang-name">Portuguese</span>
            <span class="cv-lang-level">Native</span>
          </div>
          <div class="cv-lang">
            <span class="cv-lang-name">English</span>
            <span class="cv-lang-level">Fluent</span>
          </div>
          <div class="cv-lang">
            <span class="cv-lang-name">Spanish</span>
            <span class="cv-lang-level">Intermediate</span>
          </div>
          <div class="cv-lang">
            <span class="cv-lang-name">French</span>
            <span class="cv-lang-level">Basic</span>
          </div>
          <div class="cv-lang">
            <span class="cv-lang-name">German</span>
            <span class="cv-lang-level">Beginner (A1)</span>
          </div>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ── Page layout ── */
  .cv-page {
    padding: var(--section-pad);
    padding-top: 64px;
  }

  .cv-inner {
    max-width: var(--max-w);
    margin: 0 auto;
  }

  /* ── Header ── */
  .cv-header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: end;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0;
  }

  .cv-name {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 8px;
  }

  .cv-role {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cv-contact {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .cv-contact a {
    color: var(--muted);
    transition: color var(--transition);
  }

  .cv-contact a:hover {
    color: var(--accent);
  }

  .cv-download {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  /* ── Section ── */
  .cv-section {
    padding: 36px 0;
    border-bottom: 1px solid var(--border);
  }

  .cv-section:last-child {
    border-bottom: none;
  }

  .cv-section-title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cv-section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  /* ── Entries — timeline spine down the body column ── */
  .cv-entries {
    display: flex;
    flex-direction: column;
  }

  .cv-entry {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
    padding: 14px 0;
  }

  .cv-entry:last-child {
    padding-bottom: 0;
  }

  .cv-entry:first-child {
    padding-top: 0;
  }

  .cv-entry-body {
    position: relative;
    padding-left: 22px;
    border-left: 1px solid var(--border);
  }

  .cv-entry-body::before {
    content: '';
    position: absolute;
    left: -4.5px;
    top: 7px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--surface-raised);
    border: 1px solid var(--muted);
    transition: all var(--transition);
  }

  .cv-entry:hover .cv-entry-body::before {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 10px var(--glow);
  }

  .cv-entry-date {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 2px;
  }

  .cv-date {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    color: var(--muted);
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .cv-part-time {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--border-accent);
    padding: 1px 5px;
    border-radius: var(--radius);
    width: fit-content;
    background: var(--accent-glow);
  }

  .cv-entry-header {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-bottom: 8px;
  }

  .cv-entry-title {
    font-family: var(--font-serif);
    font-size: 0.97rem;
    color: var(--text);
  }

  .cv-entry-company {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .cv-entry-desc {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 10px;
  }

  .cv-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .cv-tag {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--border);
    padding: 2px 7px;
    border-radius: var(--radius);
  }

  /* ── Skills grid ── */
  .cv-skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 48px;
  }

  /* ── Two-col sections ── */
  .cv-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 48px;
  }

  .cv-two-col .cv-section {
    border-bottom: 1px solid var(--border);
  }

  /* ── Languages ── */
  .cv-langs {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }

  .cv-lang {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition: border-color var(--transition);
  }

  .cv-lang:hover {
    border-color: var(--border-accent);
  }

  .cv-lang-name {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--text);
  }

  .cv-lang-level {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* ── Responsive ── */
  @media (max-width: 720px) {
    .cv-header {
      grid-template-columns: 1fr;
      gap: 24px;
      align-items: start;
    }

    .cv-contact {
      text-align: left;
    }

    .cv-entry {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .cv-skills-grid {
      grid-template-columns: 1fr;
    }

    .cv-two-col {
      grid-template-columns: 1fr;
    }

    .cv-langs {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.querySelectorAll<HTMLElement>('.skill-bar').forEach((bar) => {
            bar.classList.add('animate');
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.2 }
  );

  document.querySelectorAll<HTMLElement>('.cv-skills-grid .skill-list').forEach((el) => {
    observer.observe(el);
  });

  document.getElementById('cv-print')?.addEventListener('click', () => window.print());
</script>
